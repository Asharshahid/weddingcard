    align-items: center;\n    gap: 6px;\n    color: #666;\n    text-decoration: none;\n    font-family: Arial, sans-serif;\n    font-size: 12px;\n    letter-spacing: 0.3px;\n  }\n\n  .invite-footer-contact a:hover {\n    color: #9b7a3c;\n  }\n\n  .footer-icon {\n    color: #9b7a3c;\n    font-size: 14px;\n  }\n\n  .invite-footer-contact + .invite-footer-line {\n    margin-top: 20px;\n    margin-bottom: 0;\n  }\n\n  @media (max-width: 480px) {\n    .invite-footer-contact {\n      flex-direction: column;\n      gap: 9px;\n    }\n  }\n</style>"
