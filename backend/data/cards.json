      "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n<title>Wedding Invitation</title>\n\n<style>\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background: #f4efe7;\n  font-family: Georgia, \"Times New Roman\", serif;\n  color: #3f372f;\n}\n\n.wedding-card {\n  width: min(100%, 520px);\n  min-height: 100vh;\n  margin: auto;\n  padding: 25px 22px 30px;\n  background:\n    radial-gradient(circle at top left, rgba(184,151,91,.12), transparent 30%),\n    radial-gradient(circle at bottom right, rgba(184,151,91,.12), transparent 30%),\n    #fffdf9;\n  text-align: center;\n  position: relative;\n  overflow: hidden;\n}\n\n/* Decorative Border */\n.wedding-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 12px;\n  border: 1px solid #c8a96b;\n  pointer-events: none;\n}\n\n.wedding-card::after {\n  content: \"\";\n  position: absolute;\n  inset: 17px;\n  border: 1px solid rgba(200,169,107,.35);\n  pointer-events: none;\n}\n\n/* Top */\n.top {\n  padding-top: 55px;\n}\n\n.small-title {\n  font-size: 12px;\n  letter-spacing: 4px;\n  text-transform: uppercase;\n  color: #9a7a45;\n  margin-bottom: 18px;\n}\n\n.bismillah {\n  font-size: 25px;\n  margin-bottom: 18px;\n  color: #806335;\n}\n\n.invite-text {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #766b61;\n  max-width: 360px;\n  margin: auto;\n}\n\n/* Names */\n.names {\n  margin: 28px 0;\n}\n\n.name {\n  font-size: 39px;\n  font-weight: normal;\n  color: #70562f;\n  line-height: 1.2;\n}\n\n.ampersand {\n  font-size: 22px;\n  color: #b08b50;\n  margin: 7px 0;\n  font-style: italic;\n}\n\n/* Divider */\n.divider {\n  width: 80px;\n  height: 1px;\n  background: #c6a667;\n  margin: 25px auto;\n  position: relative;\n}\n\n.divider::before,\n.divider::after {\n  content: \"✦\";\n  position: absolute;\n  top: -8px;\n  color: #b08b50;\n  font-size: 12px;\n}\n\n.divider::before {\n  left: -17px;\n}\n\n.divider::after {\n  right: -17px;\n}\n\n/* Event */\n.event-title {\n  font-size: 12px;\n  letter-spacing: 3px;\n  text-transform: uppercase;\n  color: #9a7a45;\n  margin-bottom: 15px;\n}\n\n.date {\n  font-size: 24px;\n  color: #4c4137;\n  margin-bottom: 7px;\n}\n\n.time {\n  font-size: 14px;\n  color: #786d62;\n}\n\n.venue {\n  margin-top: 20px;\n  font-size: 16px;\n  color: #5d5044;\n  line-height: 1.6;\n}\n\n.address {\n  font-family: Arial, sans-serif;\n  font-size: 12px;\n  color: #8b8177;\n  margin-top: 5px;\n}\n\n/* RSVP */\n.rsvp {\n  margin: 30px auto 10px;\n  padding: 17px 20px;\n  width: 85%;\n  border-top: 1px solid rgba(190,160,105,.45);\n  border-bottom: 1px solid rgba(190,160,105,.45);\n}\n\n.rsvp-title {\n  font-size: 11px;\n  letter-spacing: 2px;\n  color: #9a7a45;\n  text-transform: uppercase;\n  margin-bottom: 8px;\n}\n\n.rsvp-text {\n  font-family: Arial, sans-serif;\n  font-size: 13px;\n  color: #71675e;\n}\n\n/* Footer */\n.invite-footer {\n  margin-top: 35px;\n  padding: 20px 10px 5px;\n}\n\n.footer-line {\n  width: 65px;\n  height: 1px;\n  background: #b99a5b;\n  margin: 0 auto 16px;\n}\n\n.footer-small {\n  font-family: Arial, sans-serif;\n  font-size: 11px;\n  letter-spacing: 1.5px;\n  color: #999087;\n  text-transform: uppercase;\n}\n\n.footer-name {\n  margin-top: 5px;\n  font-size: 19px;\n  color: #8c6d39;\n  letter-spacing: 2px;\n}\n\n.contact {\n  margin-top: 12px;\n  display: flex;\n  justify-content: center;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.contact a {\n  font-family: Arial, sans-serif;\n  font-size: 11px;\n  color: #777067;\n  text-decoration: none;\n}\n\n.contact a:hover {\n  color: #9a7a45;\n}\n\n/* Mobile */\n@media (max-width: 480px) {\n\n  .wedding-card {\n    padding-left: 20px;\n    padding-right: 20px;\n  }\n\n  .name {\n    font-size: 32px;\n  }\n\n  .invite-text {\n    font-size: 14px;\n  }\n\n  .date {\n    font-size: 21px;\n  }\n\n  .contact {\n    flex-direction: column;\n    gap: 8px;\n  }\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"wedding-card\">\n\n  <div class=\"top\">\n\n    <div class=\"small-title\">\n      Wedding Invitation\n    </div>\n\n    <div class=\"bismillah\">\n      بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ\n    </div>\n\n    <div class=\"invite-text\">\n      With the blessings of Allah and the love of our families,\n      we joyfully invite you to celebrate the beginning\n      of our beautiful journey together.\n    </div>\n\n    <div class=\"names\">\n      <div class=\"name\">Muhammad</div>\n      <div class=\"ampersand\">&</div>\n      <div class=\"name\">Ayesha</div>\n    </div>\n\n    <div class=\"divider\"></div>\n\n    <div class=\"event-title\">\n      Nikah & Wedding Celebration\n    </div>\n\n    <div class=\"date\">\n      Saturday, 20 December 2026\n    </div>\n\n    <div class=\"time\">\n      7:00 PM — 10:00 PM\n    </div>\n\n    <div class=\"venue\">\n      Pearl Banquet Hall\n    </div>\n\n    <div class=\"address\">\n      Karachi, Pakistan\n    </div>\n\n    <div class=\"rsvp\">\n      <div class=\"rsvp-title\">\n        Your Presence Matters\n      </div>\n\n      <div class=\"rsvp-text\">\n        We would be honored to have you join us\n        on this special occasion.\n      </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"invite-footer\">\n\n      <div class=\"footer-line\"></div>\n\n      <div class=\"footer-small\">\n        Invitation by\n      </div>\n\n      <div class=\"footer-name\">\n        Ashar\n      </div>\n\n      <div class=\"contact\">\n        <a href=\"tel:03441477887\">\n          ☎ 03441477887\n        </a>\n\n        <a href=\"mailto:asharshahid766@gmail.com\">\n          ✉ asharshahid766@gmail.com\n        </a>\n      </div>\n\n    </div>\n\n  </div>\n\n</div>\n\n</body>\n</html>"
